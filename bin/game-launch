#!/bin/sh

# Launch a game or pak selected by the protocol, then run DevBridge again
# inside NextUI's current launch transaction. NextUI removes /tmp/next after
# this wrapper returns, so a second handoff written here would be discarded.
# Nothing is signalled or killed: every frontend completes normally.

BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PAK_DIR=$(CDPATH= cd -- "$BIN_DIR/.." && pwd)
RETURN_LAUNCHER=${DEVBRIDGE_RETURN_LAUNCHER:-$PAK_DIR/launch.sh}
LOG=${DEVBRIDGE_GAME_LOG:-/tmp/DevBridge-game-launch.log}
RESUME_SLOT_FILE=${DEVBRIDGE_RESUME_SLOT_FILE:-/tmp/resume_slot.txt}
INPUT_SYSFS_ROOT=${DEVBRIDGE_INPUT_SYSFS_ROOT:-/sys/class/input}
INPUT_DEV_ROOT=${DEVBRIDGE_INPUT_DEV_ROOT:-/dev/input}
input_event_remap_target=
input_js_remap_target=
mirror_pid=
state_slot=
if [ "${1:-}" = --state ]; then
	[ $# -ge 3 ] || exit 2
	state_slot=$2
	shift 2
fi
launcher=$1
shift

# input_event_named NAME [physical|virtual]: the first event device called
# NAME, optionally only a real one or only a uinput one (under
# /sys/devices/virtual). The H700 virtual pad shares the physical pad's name.
input_event_named() {
	wanted=$1
	kind=${2:-}
	for input in "$INPUT_SYSFS_ROOT"/event*; do
		[ -r "$input/device/name" ] || continue
		[ "$(cat "$input/device/name" 2>/dev/null)" = "$wanted" ] || continue
		if [ -n "$kind" ]; then
			case "$(cd -P "$input/device" 2>/dev/null && pwd)" in
			*/devices/virtual/*) [ "$kind" = virtual ] || continue ;;
			*) [ "$kind" = physical ] || continue ;;
			esac
		fi
		printf '%s/%s\n' "$INPUT_DEV_ROOT" "$(basename "$input")"
		return 0
	done
	return 1
}

input_js_for_event() {
	event=$1
	for handler in "$INPUT_SYSFS_ROOT/$(basename "$event")/device"/js*; do
		[ -e "$handler" ] || continue
		printf '%s/%s\n' "$INPUT_DEV_ROOT" "$(basename "$handler")"
		return 0
	done
	return 1
}

remap_drastic_input() {
	case "$launcher" in */NDS.pak/launch.sh) ;; *) return 0 ;; esac
	if physical=$(input_event_named "TRIMUI Player1"); then
		virtual=$(input_event_named "DevBridge Virtual Controller") || return 0
	elif physical=$(input_event_named "ANBERNIC-keys" physical); then
		virtual=$(input_event_named "ANBERNIC-keys" virtual) || return 0
	else
		return 0
	fi
	[ -c "$physical" ] && [ -c "$virtual" ] || return 0
	physical_js=$(input_js_for_event "$physical" 2>/dev/null || true)
	# The physical buttons keep working through the virtual pad: the mirror
	# opens the real device now, before the bind hides it.
	if [ -x "$BIN_DIR/input" ]; then
		"$BIN_DIR/input" --mirror "$physical" "$virtual" >/dev/null 2>&1 &
		mirror_pid=$!
		sleep 0.2
	fi
	virtual_js=$(input_js_for_event "$virtual" 2>/dev/null || true)
	# DraStic 2.5.2 enumerates only the first SDL joystick. Depending on SDL's
	# udev path it opens either event3 or js0, so remap both interfaces exposed
	# by that joystick before DraStic starts.
	if mount --bind "$virtual" "$physical"; then
		input_event_remap_target=$physical
		printf 'input_remap=%s->%s\n' "$physical" "$virtual" >> "$LOG"
	fi
	if [ -c "$physical_js" ] && [ -c "$virtual_js" ] &&
		mount --bind "$virtual_js" "$physical_js"; then
		input_js_remap_target=$physical_js
		printf 'input_remap=%s->%s\n' "$physical_js" "$virtual_js" >> "$LOG"
	fi
}

restore_input() {
	if [ -n "$mirror_pid" ]; then
		kill "$mirror_pid" 2>/dev/null || true
		wait "$mirror_pid" 2>/dev/null || true
		mirror_pid=
	fi
	if [ -n "$input_js_remap_target" ]; then
		umount "$input_js_remap_target" 2>/dev/null || true
		input_js_remap_target=
	fi
	if [ -n "$input_event_remap_target" ]; then
		umount "$input_event_remap_target" 2>/dev/null || true
		input_event_remap_target=
	fi
}

trap restore_input EXIT
trap 'restore_input; exit 143' INT TERM HUP QUIT

rc=0
printf 'launcher=%s\nstate_slot=%s\nstarted=%s\n' \
	"$launcher" "$state_slot" "$(date '+%Y-%m-%dT%H:%M:%S%z')" > "$LOG"
remap_drastic_input
if [ -n "$state_slot" ]; then
	resume_tmp="${RESUME_SLOT_FILE}.$$"
	printf '%s\n' "$state_slot" > "$resume_tmp" || exit 1
	mv "$resume_tmp" "$RESUME_SLOT_FILE" || exit 1
fi
"$launcher" "$@" || rc=$?
restore_input
[ -z "$state_slot" ] || rm -f "$RESUME_SLOT_FILE"
printf 'launcher_rc=%s\n' "$rc" >> "$LOG"
return_rc=0
"$RETURN_LAUNCHER" || return_rc=$?
[ "$rc" -ne 0 ] || rc=$return_rc
exit "$rc"
