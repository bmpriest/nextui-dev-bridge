#!/bin/sh

BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PAK_DIR=$(CDPATH= cd -- "$BIN_DIR/.." && pwd)
. "$BIN_DIR/paths.sh"

# On Spruce, PyUI and RetroArch read only the built-in pad (ANBERNIC-keys on
# H700, TRIMUI Player1 on the Brick; RetroArch as SDL joypad 0), so a uinput pad
# is invisible to the menu and lands on an unmapped player 2 in games.
# spruce-input writes into the built-in pad's node with Spruce's sendevent.
# On the A30 RetroArch reads MIYOO Pad1, which spruce's joypad daemon makes
# from the gpio-keys-polled keyboard, so spruce-input writes keyboard codes
# into that keyboard and the daemon carries them on like real presses.
# Other Spruce models keep the existing virtual pad.
# The Miyoo Mini family has no named pad; spruce-input writes to its event0.
if spruce_direct_input; then
	exec "$BIN_DIR/spruce-input" "$@"
fi

if uname -m 2>/dev/null | grep -q 64; then
	ARCH_DIR=arm64
else
	ARCH_DIR=arm
fi

exec "$BIN_DIR/$ARCH_DIR/devbridge-input" "$@"
